# ==============================================================================
# MAGANGHUB ATTENDANCE ASSISTANT (MAA) - ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase PostgreSQL Configuration
# Dapatkan dari Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection String (Opsional - Diperlukan jika menggunakan direct pooler)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Keamanan & Enkripsi Rahasia (Authenticated AES-256-GCM)
# Generate 32 bytes hex menggunakan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_MONEV_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Kunci Rahasia Sesi MAA (JWT / Session)
MAA_SESSION_SECRET=kunci_rahasia_sesi_minimal_32_karakter_acak_untuk_keamanan

# Penjadwalan & Vercel Cron (Setiap 30 Menit)
CRON_SECRET=kunci_rahasia_bearer_token_cron_anda
SYNC_INTERVAL_MINUTES=30
DEFAULT_TIMEZONE=Asia/Makassar

# URL Aplikasi & API Kemnaker
APP_URL=http://localhost:3000
MONEV_API_BASE_URL=https://monev-api.maganghub.kemnaker.go.id

# Server Integration Token (Opsional - Hanya jika diterbitkan secara sah oleh Kemnaker)
# MONEV_API_ENABLED=false
# MONEV_AUTH_TOKEN=
# MONEV_PARTICIPANT_ID=
