# ==============================================================================
# MAGANGHUB ATTENDANCE ASSISTANT (MAA) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin ke .env.local untuk konfigurasi lokal:
# cp .env.example .env.local

# 1. Autentikasi & Sesi Pengguna MAA
MAA_JWT_SECRET="ganti_dengan_kunci_acak_minimal_32_karakter_untuk_keamanan_sesi"

# 2. Database Persisten Lokal (SQLite)
DATABASE_PATH="data/maa.db"

# 3. Kredensial Resmi Server Monev Kemnaker
# (Hanya aktif jika instansi Anda memiliki otorisasi resmi Kemnaker RI)
MONEV_API_ENABLED="false"
MONEV_API_BASE_URL="https://monev-api.maganghub.kemnaker.go.id"
MONEV_PARTICIPANT_ID=""
MONEV_AUTH_TOKEN=""


# 4. Pengaturan Zona Waktu (Default: WITA)
DEFAULT_TIMEZONE="Asia/Makassar"
