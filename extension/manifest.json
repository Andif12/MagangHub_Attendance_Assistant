{
  "manifest_version": 3,
  "name": "MAA MagangHub Attendance Companion",
  "version": "1.3.0",
  "description": "Ekstensi resmi pendamping MAA untuk membaca presensi Monev MagangHub secara langsung melalui sesi browser pengguna tanpa manipulasi data.",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.kemnaker.go.id/*",
    "https://*.maganghub.kemnaker.go.id/*",
    "https://monev-api.maganghub.kemnaker.go.id/*",
    "https://monev.maganghub.kemnaker.go.id/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monev.maganghub.kemnaker.go.id/*"
      ],
      "js": ["content-monev.js"]
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content-localhost.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAA Presensi Assistant"
  }
}
