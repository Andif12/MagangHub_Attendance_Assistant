{
  "manifest_version": 3,
  "name": "MAA MagangHub Attendance Companion (DOM-Only)",
  "version": "2.0.0",
  "description": "Ekstensi pendamping MAA resmi untuk membaca data presensi yang sudah dirender di DOM portal Monev tanpa mengambil atau menyimpan token/kredensial.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://monev.maganghub.kemnaker.go.id/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monev.maganghub.kemnaker.go.id/*"
      ],
      "js": ["content-monev.js"]
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content-localhost.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAA Presensi Assistant (DOM-Only)"
  }
}
